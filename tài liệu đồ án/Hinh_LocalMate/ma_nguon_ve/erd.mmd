    ObjectId _id PK
    ObjectId bookingId FK
    number amount
    enum status
  }
  REVIEW {
    ObjectId _id PK
    ObjectId bookingId FK
    ObjectId guideId FK
    number rating
  }
  MESSAGE {
    ObjectId _id PK
    ObjectId bookingId FK
    ObjectId senderId FK
    ObjectId receiverId FK
    string text
  }
  WALLET {
    ObjectId _id PK
    ObjectId guideId FK
    number balance
  }
  WITHDRAWAL_REQUEST {
    ObjectId _id PK
    ObjectId guideId FK
    number amount
    enum status
  }
  GUIDE_SCHEDULE {
    ObjectId _id PK
    ObjectId guideId FK
    date date
  }
  NOTIFICATION {
    ObjectId _id PK
    ObjectId userId FK
    enum type
  }
  BOOKMARK {
    ObjectId _id PK
    ObjectId userId FK
    ObjectId targetId FK
