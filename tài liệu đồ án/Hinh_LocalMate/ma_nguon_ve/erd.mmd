  USER {
    ObjectId _id PK
    string email UK
    string fullName
    enum role
    boolean isBlocked
  }
  GUIDE_PROFILE {
    ObjectId _id PK
    ObjectId userId FK
    number hourlyRate
    number ratingAvg
    boolean isApproved
  }
  LOCATION {
    ObjectId _id PK
    string name
    enum category
    string city
    geojson coordinates
  }
  BOOKING {
    ObjectId _id PK
    ObjectId touristId FK
    ObjectId guideId FK
    ObjectId locationId FK
    enum status
    number totalAmount
  }
