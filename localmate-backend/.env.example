# ==============================================================================
# LOCALMATE BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173

# Database Connection (MongoDB)
# 1. Local MongoDB: mongodb://127.0.0.1:27017/localmate
# 2. Docker Compose: mongodb://mongodb:27017/localmate
# 3. MongoDB Atlas (Cloud Free Tier): mongodb+srv://<username>:<password>@cluster0.mongodb.net/localmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/localmate

# JWT Authentication
JWT_ACCESS_SECRET=localmate_jwt_access_super_secret_key_2026
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_SECRET=localmate_jwt_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRES=30d

# Business & Platform Commission Settings
PLATFORM_FEE_PERCENT=10

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Media Storage (Cloudinary - Optional)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=placeholder_secret

# Notification & Email (Nodemailer - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@localmate.com
SMTP_PASS=placeholder_pass
EMAIL_FROM=LocalMate Support <noreply@localmate.com>
