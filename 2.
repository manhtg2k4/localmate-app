import React, { memo, useState, useCallback, useRef, useEffect } from "react";
import {
  View,
  TextInput,
  FlatList,
  Text,
  TouchableOpacity,
  Keyboard,
  Platform,
  Modal,
  TouchableWithoutFeedback,
  StyleSheet,
  Animated,
  Easing,
  EmitterSubscription,
} from "react-native";
import AntDesign from "react-native-vector-icons/AntDesign";
import MaterialIcons from "react-native-vector-icons/MaterialIcons";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { useInput } from "../../utils/useInput";

interface CommentInputProps {
  onSendComment: (comment: any) => void;
  setIsFocused?: (focused: boolean) => void;
  projectId?: string;
  code?: string;
  textMng?: boolean;
  toBookNumber?: any;
}

const CommentInput: React.FC<CommentInputProps> = ({
  onSendComment,
  projectId,
  code,
  textMng,
  setIsFocused,
}) => {
  const { value: message, setValue: setMessage } = useInput("");
  const [attachFile, setAttachFile] = useState<any[]>([]);
  const [modalVisible, setModalVisible] = useState(false);
  const inputRef = useRef<TextInput>(null);
  const insets = useSafeAreaInsets();

  // --- Tự theo dõi chiều cao bàn phím thay vì phụ thuộc KeyboardAvoidingView ---
  // translateY dùng để "kéo" khối input dính sát mép trên của bàn phím.
  const translateY = useRef(new Animated.Value(0)).current;

  // Theo dõi trạng thái bàn phím đang hiện hay không, và có yêu cầu "đóng hẳn Modal"
  // đang chờ animation ẩn bàn phím chạy xong hay không. Nhờ 2 ref này, việc đóng Modal
  // luôn được gộp làm 1 thao tác duy nhất, không cần bấm 2 lần.
  const isKeyboardVisibleRef = useRef(false);
  const pendingCloseRef = useRef(false);

  useEffect(() => {
    const showEvent = Platform.OS === "ios" ? "keyboardWillShow" : "keyboardDidShow";
    const hideEvent = Platform.OS === "ios" ? "keyboardWillHide" : "keyboardDidHide";

    const showSub: EmitterSubscription = Keyboard.addListener(showEvent, (e) => {
      isKeyboardVisibleRef.current = true;
      const keyboardHeight = e.endCoordinates.height;
      Animated.timing(translateY, {
        toValue: -keyboardHeight,
        duration: Platform.OS === "ios" ? e.duration || 250 : 220,
        easing: Easing.out(Easing.ease),
        useNativeDriver: true,
      }).start();
    });

    const hideSub: EmitterSubscription = Keyboard.addListener(hideEvent, (e) => {
      isKeyboardVisibleRef.current = false;
      Animated.timing(translateY, {
        toValue: 0,
        duration: Platform.OS === "ios" ? e.duration || 200 : 180,
        easing: Easing.out(Easing.ease),
        useNativeDriver: true,
      }).start(() => {
        // Chỉ khi animation ẩn bàn phím chạy xong hoàn toàn mới thật sự đóng Modal.
        // Nhờ vậy nhấn ra khoảng trống chỉ cần 1 lần là đóng gọn, không bị giật.
        if (pendingCloseRef.current) {
          pendingCloseRef.current = false;
          setModalVisible(false);
          if (setIsFocused) setIsFocused(false);
        }
      });
    });

    return () => {
      showSub.remove();
      hideSub.remove();
    };
  }, [translateY, setIsFocused]);

  // --- Chỉ 1 nguồn duy nhất gọi focus, đúng 1 lần, mỗi khi Modal mở lên ---
  const handleModalShow = () => {
    requestAnimationFrame(() => {
      inputRef.current?.focus();
    });
  };

  // --- Đóng Modal: gộp việc ẩn bàn phím + đóng Modal thành đúng 1 thao tác ---
  const closeModal = useCallback(() => {
    if (isKeyboardVisibleRef.current) {
      // Bàn phím đang mở: yêu cầu đóng sẽ được xử lý ở hideSub bên trên,
      // ngay khi animation ẩn bàn phím hoàn tất.
      pendingCloseRef.current = true;
      Keyboard.dismiss();
    } else {
      // Bàn phím đã ẩn sẵn (hiếm khi xảy ra) → đóng Modal ngay, không cần chờ.
      setModalVisible(false);
      if (setIsFocused) setIsFocused(false);
    }
  }, [setIsFocused]);

  const handleSendMessage = async () => {
    if (message.trim() !== "" || attachFile.length) {
      closeModal();

      try {
        const newComment = {
          code: code,
          content: message,
          id: projectId || null,
          image: [],
          replyUser: [],
        };
        onSendComment(newComment);
      } catch (error) {
        console.error("Lỗi khi gửi bình luận:", error);
      }

      setMessage("");
      setAttachFile([]);
    }
  };

  const onDeleteFile = useCallback((index: number) => {
    setAttachFile((prev) => prev.filter((_, i) => i !== index));
  }, []);

  const handleOpenModal = () => {
    setModalVisible(true);
    if (setIsFocused) setIsFocused(true);
  };

  // Nhấn ra khoảng trống (overlay) để thoát → dùng chung logic đóng gộp 1 thao tác.
  const handleCloseModal = closeModal;

  return (
    <View>
      {/* 1. Nút kích hoạt mở ô nhập */}
      <TouchableOpacity
        activeOpacity={0.8}
        onPress={handleOpenModal}
        style={styles.inlineContainer}
      >
        <Text style={[styles.inlineInputText, !message && { color: "#888" }]} numberOfLines={1}>
          {message || "Viết ý kiến..."}
        </Text>
        <MaterialIcons name="send" size={24} color="#007AFF" />
      </TouchableOpacity>

      {/* 2. Modal chứa TextInput thực sự */}
      <Modal
        visible={modalVisible}
        transparent
        animationType="fade"
        statusBarTranslucent
        onShow={handleModalShow}
        onRequestClose={handleCloseModal}
      >
        <TouchableWithoutFeedback onPress={handleCloseModal}>
          <View style={styles.modalOverlay} />
        </TouchableWithoutFeedback>

        {/* Không còn dùng KeyboardAvoidingView — thay bằng Animated.View
            dịch chuyển theo đúng chiều cao bàn phím đo được ở trên. */}
        <Animated.View
          style={[styles.animatedWrapper, { transform: [{ translateY }] }]}
        >
          <View
            style={[
              styles.modalInputContainer,
              { paddingBottom: Platform.OS === "ios" ? insets.bottom || 12 : 12 },
            ]}
          >
            {textMng && attachFile.length > 0 && (
              <FlatList
                horizontal
                contentContainerStyle={{ paddingHorizontal: 10, marginBottom: 10 }}
                data={attachFile}
                keyExtractor={(item) => item.name}
                renderItem={({ item, index }) => (
                  <View style={styles.fileTag}>
                    <Text numberOfLines={1} style={{ maxWidth: 80 }}>
                      {item.name}
                    </Text>
                    <AntDesign
                      name="close"
                      size={18}
                      style={{ marginLeft: 5 }}
                      onPress={() => onDeleteFile(index)}
                    />
                  </View>
                )}
              />
            )}

            <View style={styles.inputRow}>
              <TextInput
                ref={inputRef}
                value={message}
                onChangeText={setMessage}
                placeholder="Viết ý kiến..."
                placeholderTextColor="#888"
                style={styles.inputStyle}
                multiline
              // Bỏ autoFocus: để handleModalShow là nguồn focus duy nhất,
              // tránh 2 request focus chạy đua nhau.
              />
              <TouchableOpacity onPress={handleSendMessage}>
                <MaterialIcons name="send" size={24} color="#007AFF" />
              </TouchableOpacity>
            </View>
          </View>
        </Animated.View>
      </Modal>
    </View>
  );
};

const styles = StyleSheet.create({
  inlineContainer: {
    flexDirection: "row",
    alignItems: "center",
    borderWidth: 1,
    borderColor: "#ccc",
    borderRadius: 6,
    marginTop: 10,
    marginHorizontal: 10,
    paddingHorizontal: 10,
    width: "98%",
    height: 44,
  },
  inlineInputText: {
    flex: 1,
    paddingHorizontal: 5,
    fontSize: 14,
    color: "#000",
  },
  modalOverlay: {
    flex: 1,
    backgroundColor: "rgba(0, 0, 0, 0.35)",
  },
  animatedWrapper: {
    position: "absolute",
    bottom: 0,
    left: 0,
    right: 0,
  },
  modalInputContainer: {
    backgroundColor: "#fff",
    paddingHorizontal: 10,
    paddingTop: 10,
    borderTopWidth: 1,
    borderTopColor: "#e5e5e5",
    elevation: 8,
    shadowColor: "#000",
    shadowOffset: { width: 0, height: -2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
  },
  inputRow: {
    flexDirection: "row",
    alignItems: "center",
    borderWidth: 1,
    borderColor: "#ccc",
    borderRadius: 6,
    paddingHorizontal: 10,
    backgroundColor: "#fff",
  },
  inputStyle: {
    flex: 1,
    paddingHorizontal: 5,
    paddingVertical: 10,
    maxHeight: 100,
    fontSize: 14,
    color: "#000",
  },
  fileTag: {
    height: 30,
    flexDirection: "row",
    alignItems: "center",
    backgroundColor: "#ccc",
    borderRadius: 20,
    paddingHorizontal: 15,
    marginRight: 5,
  },
});

export default memo(CommentInput);